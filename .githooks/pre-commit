#!/bin/sh
# Enforces: if the dashboard HTML is staged, CLAUDE.md must be staged too.
# One-time setup per clone: git config core.hooksPath .githooks

staged=$(git diff --cached --name-only)

if echo "$staged" | grep -q '^NSDC_Skill_Intelligence_Dashboard\.html$'; then
  if ! echo "$staged" | grep -q '^CLAUDE\.md$'; then
    echo ""
    echo "BLOCKED: you're committing a change to the dashboard without updating CLAUDE.md."
    echo "Add what changed and why to CLAUDE.md, then 'git add CLAUDE.md' and commit again."
    echo "(Skip this check just once with: git commit --no-verify)"
    echo ""
    exit 1
  fi
fi

exit 0
